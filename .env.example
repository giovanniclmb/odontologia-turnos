# Copiá este archivo a .env y completá las tres contraseñas con valores locales.
# Si cambiás DB_PORT, actualizá también el puerto de DB_URL.
DB_PORT=5433
DB_URL=jdbc:postgresql://127.0.0.1:5433/odontologia_dev
DB_USER=odonto_app
DB_MIGRATION_USER=odonto_migrator
DB_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_BOOTSTRAP_PASSWORD=
BOOTSTRAP_NOMBRE_USUARIO=
BOOTSTRAP_ROL=
BOOTSTRAP_CONTRASENA=
# Email (transporte C-17, opcional para arranque; obligatorio para enviar)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_ALLOWLIST=
EMAIL_MAX_RETRIES=2
EMAIL_TIMEOUT=10s
